# ============================================================
# Tooba Support Bridge — standalone server config
# Copy this file to server/.env and fill real values.
# NEVER commit server/.env
# ============================================================

# --- Microsoft Graph (delegated, device-code flow) ---
# Azure App Registration. Delegated permissions: Mail.Read, Mail.Send,
# User.Read, offline_access (no tenant admin consent needed).
# Azure → app → Authentication → "Allow public client flows" = Yes
# No client secret needed for device-code flow.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_MAILBOX=support@tooba.com

# --- Slack ---
# api.slack.com/apps → your app → OAuth & Permissions
# Bot Token Scopes: chat:write
# Install to workspace, copy the Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_ID=C0ATU9ZD2UF

# --- Optional ---
OWN_DOMAINS=@tooba.com,@mx.tooba.com
POLL_SECONDS=30
