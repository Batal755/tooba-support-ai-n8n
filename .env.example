# ============================================================
# Tooba Support AI – n8n Automation
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ============================================================

# n8n instance base URL (no trailing slash)
N8N_BASE_URL=http://localhost:5678

# n8n API key — Settings → API → Create API key
N8N_API_KEY=your_n8n_api_key_here

# Slack channel ID for support_ai_test (e.g. C0XXXXXXXXX)
# Find it: right-click channel in Slack → View channel details → Channel ID
SLACK_CHANNEL_ID=C0XXXXXXXXX
